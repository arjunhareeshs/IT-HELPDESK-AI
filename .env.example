# Server Configuration
PROJECT_NAME="IT Helpdesk AI Triage"
VERSION="0.0.1"
API_V1_STR="/api/v1"
APP_ENV=development

# Groq API & LangChain Model Configuration
# Obtain your API key from: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_STEPS=6
LLM_MAX_TOOL_ROWS=25
LLM_QUERY_TIMEOUT_MS=1500
LLM_QUERY_MAX_REPAIR_ATTEMPTS=2

# Ollama LLM Configuration (Local Fallback)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OLLAMA_TIMEOUT_SECONDS=30.0

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/it_helpdesk"
